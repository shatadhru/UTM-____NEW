# ==============================================================================
# NextLoad - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB via Mongoose)
# ------------------------------------------------------------------------------
# MongoDB connection URI
DATABASE_URL=mongodb://127.0.0.1:27017/nextload

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS 3.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and tokens in Payload CMS (min 32 characters)
PAYLOAD_SECRET=your-random-payload-secret-key-min-32-chars

# ------------------------------------------------------------------------------
# 3. BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for session signing in Better Auth (min 32 characters)
BETTER_AUTH_SECRET=your-random-better-auth-secret-key-min-32-chars

# Base URL of your Next.js application
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL SERVICE (Hostinger / Custom SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="NextLoad <support@yourdomain.com>"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (Optional - for Social Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. CLOUDINARY CDN CONFIGURATION (Media & Avatar Uploads)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard > Settings > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS (bKash & Nagad)
# ------------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_CALLBACK_URL=http://localhost:3000/api/checkout/bkash/callback
# BKASH_MERCHANT_ASSOCIATION_INFO=your-merchant-association-info

# Nagad Manual Account Settings
NEXT_PUBLIC_NAGAD_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_NAGAD_TYPE=Personal

# ------------------------------------------------------------------------------
# 8. SMS GATEWAY CONFIGURATION (sms.net.bd / sms.bd / Tauri 2.0 Link)
# ------------------------------------------------------------------------------
# Option A: Direct API Key from sms.net.bd (Recommended)
SMS_NET_BD_API_KEY=your-sms-net-bd-api-key
SMS_NET_BD_SENDER_ID=

# Option B: Tauri 2.0 Link / Custom Gateway (if using a Tauri device bridge)
TAURI_SMS_LINK=
SMS_GATEWAY_ID=
SMS_GATEWAY_PASSWORD=

# Optional: Approved Sender ID (Masking/Non-masking)
SMS_GATEWAY_SENDER_ID=

# ------------------------------------------------------------------------------
# 9. MESSAGE QUEUE CONFIGURATION (RabbitMQ - High Concurrency / 1,000+ Students)
# ------------------------------------------------------------------------------
# AMQP connection URL for RabbitMQ broker (e.g. CloudAMQP, Docker, or self-hosted)
# Format: amqp://username:password@hostname:5672/vhost
# If omitted or offline, the system seamlessly falls back to an in-memory batch queue.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
